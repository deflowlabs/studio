# Required public configuration. SANITY_STUDIO_* values are embedded in the
# browser bundle; never place tokens or secrets in them.
SANITY_STUDIO_PROJECT_ID=i34vbeac
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2026-08-17

# Website used by Presentation/live preview. Prefer a stable Vercel environment
# domain instead of an arbitrary ephemeral Preview URL.
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000

# Technical GROQ query tool; keep false for normal and production editors.
SANITY_STUDIO_ENABLE_VISION=false
