{
  "name": "@deflow/studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "check": "npm run typecheck && npm test && npm run schema:extract",
    "deploy": "sanity deploy",
    "schema:extract": "sanity schema extract --path schema.json --force",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typegen": "sanity typegen generate"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@sanity/code-input": "7.3.5",
    "@sanity/icons": "3.7.4",
    "@sanity/vision": "6.9.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "6.9.2",
    "styled-components": "6.5.3",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  },
  "overrides": {
    "js-yaml": ">=4.3.1",
    "smol-toml": ">=1.6.1",
    "@module-federation/dts-plugin": {
      "undici": "7.29.0"
    },
    "uuid": ">=11.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
